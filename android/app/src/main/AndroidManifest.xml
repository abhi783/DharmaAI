<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.dharma_ai">

    <!-- Required to access internet for backend calls -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Microphone permission for speech-to-text / voice features -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:label="Dharma AI"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Don't add additional services or receivers here without consulting the security model. -->
    </application>
</manifest>
